{
  "name": "dkod",
  "displayName": "DKOD",
  "version": "0.17.71",
  "description": "Build and deploy apps through your company's DKOD: policy, templates, Deploy questions and Deliver.",
  "author": {
    "name": "DKOD"
  },
  "homepage": "https://dkod.ai",
  "repository": "https://github.com/dkod-ai/dkod-plugin",
  "license": "MIT",
  "keywords": [
    "dkod",
    "deploy",
    "governance",
    "platform",
    "mcp",
    "gitops"
  ],
  "logo": "assets/logo.svg",
  "skills": "./skills/",
  "rules": "./rules/",
  "mcpServers": {
    "dkod": {
      "url": "https://dashboard.dkod.app/api/v1/dkoder/mcp"
    }
  },
  "hooks": {
    "version": 1,
    "hooks": {
      "sessionStart": [
        {
          "command": "node \"${CURSOR_PLUGIN_ROOT:-.}/hooks/cursor-guard.mjs\""
        }
      ],
      "preToolUse": [
        {
          "command": "node \"${CURSOR_PLUGIN_ROOT:-.}/hooks/cursor-guard.mjs\""
        }
      ],
      "beforeShellExecution": [
        {
          "command": "node \"${CURSOR_PLUGIN_ROOT:-.}/hooks/cursor-guard.mjs\""
        }
      ],
      "beforeMCPExecution": [
        {
          "command": "node \"${CURSOR_PLUGIN_ROOT:-.}/hooks/cursor-guard.mjs\""
        }
      ],
      "afterMCPExecution": [
        {
          "command": "node \"${CURSOR_PLUGIN_ROOT:-.}/hooks/cursor-guard.mjs\""
        }
      ],
      "afterFileEdit": [
        {
          "command": "node \"${CURSOR_PLUGIN_ROOT:-.}/hooks/cursor-guard.mjs\""
        }
      ],
      "afterShellExecution": [
        {
          "command": "node \"${CURSOR_PLUGIN_ROOT:-.}/hooks/cursor-guard.mjs\""
        }
      ],
      "stop": [
        {
          "command": "node \"${CURSOR_PLUGIN_ROOT:-.}/hooks/cursor-guard.mjs\"",
          "loop_limit": 1
        }
      ]
    }
  }
}
