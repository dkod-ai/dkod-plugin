#!/bin/sh
# dk: install, upgrade, check and remove the DKOD plugin in Claude Code, Cursor, Codex and GitHub Copilot CLI.
# install.sh puts it in ~/.local/bin/dk. Run `dk help` for the commands.
#
# Channels:
#   stable   the latest GitHub release of dkod-ai/dkod-plugin (the default, and the one to use)
#   nightly  the newest commit on main, published from DKOD's source every night
# Questions come from the terminal (/dev/tty), so they work under `curl | sh` too. With no terminal, set:
#   DKOD_AGENT=claude,cursor,codex,copilot or all   DKOD_CHANNEL=stable|nightly
# DKOD_GRAPHIFY=1 installs graphify with no question, DKOD_GRAPHIFY=0 skips it.
# DKOD_NONINTERACTIVE=1 never asks, even with a terminal (for a script or a device rollout).
# dk never uses sudo, and it never touches a copy your company installed on this device.
set -eu
umask 022

DK_VERSION=1.1.1
REPO="${DKOD_PLUGIN_REPO:-dkod-ai/dkod-plugin}"
MARKET=dkod-ai
PLUGIN_ID="dkod@$MARKET"
MCP_URL="https://dashboard.dkod.app/api/v1/dkoder/mcp"
HOME="${HOME:?HOME is not set}"
BIN_DIR="${DKOD_BIN_DIR:-$HOME/.local/bin}"
DK_BIN="$BIN_DIR/dk"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dkod"
DK_CHANNEL_FILE="$CONFIG_DIR/channel"
CURSOR_DIR="$HOME/.cursor/plugins/local/dkod"
CURSOR_CHANNEL_FILE="$CONFIG_DIR/plugin-channel"
CODEX_CONFIG="${CODEX_HOME:-$HOME/.codex}/config.toml"
COPILOT_SETTINGS="${COPILOT_HOME:-$HOME/.copilot}/settings.json"
AGENTS="claude cursor codex copilot"

# --- Output -------------------------------------------------------------------------------------

use_color=false
if [ -t 1 ] && [ "${TERM:-}" != dumb ]; then
  case "${TERM:-}" in xterm*|screen*|tmux*|rxvt*|linux|ansi|cygwin) use_color=true ;; esac
  case "${COLORTERM:-}" in truecolor|24bit) use_color=true ;; esac
  [ -z "${NO_COLOR+x}" ] || use_color=false
fi
paint() { if [ "$use_color" = true ]; then printf '\033[%sm%s\033[0m' "$1" "$2"; else printf '%s' "$2"; fi; }
# Generated from DKOD-V-4096.png with ascii-image-converter v1.13.1, the same wordmark as
# https://dkod.ai/try/install.sh.
show_wordmark() {
  [ -t 1 ] && [ "${TERM:-}" != dumb ] || return 0
  printf '\n'
  if [ "$use_color" = true ]; then printf '\033[36m'; fi
  cat <<'DKOD_WORDMARK'
⣮⡻⣿⣿⣷⣦⡀⢸⣿⡇⠀⣠⣾⣿⠟⣡⣶⣿⢸⣷⣦⡀⠀⣮⡻⣿⣿⣷⣦⡀
⣿⣿⠀⠀⠉⠿⠷⠸⠿⠇⠾⠿⠟⠁⠸⠿⠏⠀⠀⠉⠿⠿⠄⣿⣿⠀⠀⠉⠿⠷
⣿⣿⠀⠀⣀⣾⡿⢸⣿⡇⢿⣿⣦⡀⢸⣿⣆⠀⠀⣀⣾⣿⠃⣿⣿⠀⠀⣀⣾⡿
⢟⣵⣿⣿⡿⠟⠁⢸⣿⡇⠀⠙⢿⣿⣦⡙⠿⣿⢸⡿⠟⠁⠀⢟⣵⣿⣿⡿⠟⠁
DKOD_WORDMARK
  if [ "$use_color" = true ]; then printf '\033[0m'; fi
  printf '\n'
}
say() { printf '%s\n' "$*"; }
step() { printf '%s %s\n' "$(paint 36 '›')" "$*"; }
ok() { printf '%s %s\n' "$(paint 32 '✓')" "$*"; }
note() { printf '%s %s\n' "$(paint 33 '!')" "$*"; }
fail() { printf '%s %s\n' "$(paint 31 '✗')" "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "Please install $1 and run this command again."; }

fetch() {
  curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 --connect-timeout 15 --max-time 120 --retry 2 "$@"
}

# The answers come from the terminal, opened once on fd 3. DKOD_TTY names another file (the tests use it).
TTY=
open_tty() {
  [ -z "${DKOD_NONINTERACTIVE:-}" ] || return 0
  tty_path=${DKOD_TTY:-/dev/tty}
  if [ -r "$tty_path" ] && (exec <"$tty_path") 2>/dev/null; then exec 3<"$tty_path"; TTY=$tty_path; fi
}
# The answer to a question. $1 is the default, used for an empty answer and when there is no terminal.
ask() {
  if [ -z "$TTY" ]; then printf '%s' "$1"; return; fi
  read -r answer <&3 || answer=
  printf '%s' "${answer:-$1}"
}
yes_no() { # $1 the question, $2 the default (y or n)
  if [ "$2" = y ]; then printf '%s [Y/n]: ' "$1"; else printf '%s [y/N]: ' "$1"; fi
  case $(ask "$2") in y|Y|yes|Yes) return 0 ;; esac
  return 1
}

# 0 when version $1 is older than version $2 (MAJOR.MINOR.PATCH).
older() {
  awk -v a="$1" -v b="$2" 'BEGIN { split(a, x, "."); split(b, y, ".");
    for (i = 1; i <= 3; i++) { if (x[i] + 0 < y[i] + 0) exit 0; if (x[i] + 0 > y[i] + 0) exit 1 } exit 1 }'
}
json_version() { sed -nE 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "$1" | head -n 1; }
label() {
  case $1 in claude) printf 'Claude Code' ;; cursor) printf 'Cursor' ;; codex) printf 'Codex' ;; copilot) printf 'GitHub Copilot CLI' ;; esac
}
# Reads a per-agent variable: get claude version -> $claude_version.
get() { eval "printf '%s' \"\${$1_$2:-}\""; }
has() { case " $1 " in *" $2 "*) return 0 ;; esac; return 1; }
ref_of() { if [ "$1" = nightly ]; then printf main; else printf stable; fi; }

dk_channel() {
  if [ -f "$DK_CHANNEL_FILE" ] && [ "$(cat "$DK_CHANNEL_FILE")" = nightly ]; then printf nightly; else printf stable; fi
}
save_dk_channel() { mkdir -p "$CONFIG_DIR"; printf '%s\n' "$1" >"$DK_CHANNEL_FILE"; }

# --- What is installed now ----------------------------------------------------------------------

claude_installed_version() {
  claude plugin list --json 2>/dev/null | awk -v id="\"$PLUGIN_ID\"" '
    $0 ~ "\"id\"" { hit = index($0, id) > 0 } hit && /"version"/ { sub(/.*"version"[^"]*"/, ""); sub(/".*/, ""); print; exit }'
}
# `codex plugin list --json` lists installed and available plugins; only an installed one counts.
codex_installed_version() {
  codex plugin list --json 2>/dev/null | awk -v id="\"$PLUGIN_ID\"" '
    /"pluginId"/ { hit = index($0, id) > 0; v = "" }
    hit && /"version"/ { v = $0; sub(/.*"version"[^"]*"/, "", v); sub(/".*/, "", v) }
    hit && /"installed"[[:space:]]*:[[:space:]]*true/ { print v; exit }
    hit && /"installed"[[:space:]]*:[[:space:]]*false/ { hit = 0 }'
}
copilot_installed_version() {
  copilot plugin list --json 2>/dev/null | awk '
    /"name"/ { hit = ($0 ~ /"dkod"/) } hit && /"marketplace"/ { hit = ($0 ~ /"dkod-ai"/) }
    hit && /"version"/ { sub(/.*"version"[^"]*"/, ""); sub(/".*/, ""); print; exit }'
}
has_marketplace() { "$1" plugin marketplace list --json 2>/dev/null | grep -q "\"$MARKET\""; }

detect() {
  claude_app=false; command -v claude >/dev/null 2>&1 && claude_app=true
  cursor_app=false
  if command -v cursor >/dev/null 2>&1 || command -v cursor-agent >/dev/null 2>&1 || [ -d "$HOME/.cursor" ] || [ -d /Applications/Cursor.app ]; then cursor_app=true; fi
  codex_app=false; command -v codex >/dev/null 2>&1 && codex_app=true
  copilot_app=false; command -v copilot >/dev/null 2>&1 && copilot_app=true

  claude_version=; claude_ref=; claude_locked=
  if [ "$claude_app" = true ]; then
    plugins=$(claude plugin list --json 2>/dev/null || :)
    claude_version=$(claude_installed_version)
    case $plugins in *'"dkod@dkod-managed"'*) claude_locked="installed by your company, it updates by itself" ;; esac
    claude_ref=$(claude plugin marketplace list --json 2>/dev/null | awk -v name="\"$MARKET\"" '
      /"name"/ { hit = index($0, name) > 0 } hit && /"ref"/ { sub(/.*"ref"[^"]*"/, ""); sub(/".*/, ""); print; exit } /}/ { hit = 0 }')
  fi
  claude_channel=stable; [ "$claude_ref" = main ] && claude_channel=nightly

  cursor_version=; cursor_channel=stable; cursor_locked=
  [ -f "$CURSOR_DIR/.cursor-plugin/plugin.json" ] && cursor_version=$(json_version "$CURSOR_DIR/.cursor-plugin/plugin.json")
  [ -f "$CURSOR_CHANNEL_FILE" ] && [ "$(cat "$CURSOR_CHANNEL_FILE")" = nightly ] && cursor_channel=nightly
  for d in "$HOME"/.cursor/plugins/cache/*/dkod; do [ -d "$d" ] && cursor_locked="installed by your team marketplace, Cursor updates it"; done

  # Codex and Copilot keep the marketplace ref in their own config. Only a ref of stable is stable:
  # a marketplace added with no ref follows main.
  codex_version=; codex_ref=; codex_locked=
  if [ "$codex_app" = true ]; then
    codex_version=$(codex_installed_version)
    [ -f "$CODEX_CONFIG" ] && codex_ref=$(awk -v sec="[marketplaces.$MARKET]" '
      /^\[/ { hit = ($0 == sec) } hit && /^[[:space:]]*ref[[:space:]]*=/ { sub(/^[^"]*"/, ""); sub(/".*/, ""); print; exit }' "$CODEX_CONFIG")
  fi
  codex_channel=nightly; [ "$codex_ref" = stable ] && codex_channel=stable; [ -n "$codex_version" ] || codex_channel=stable

  copilot_version=; copilot_ref=; copilot_locked=
  if [ "$copilot_app" = true ]; then
    copilot_version=$(copilot_installed_version)
    [ -f "$COPILOT_SETTINGS" ] && copilot_ref=$(awk -v name="\"$MARKET\"" '
      !hit && index($0, name) && /\{/ { hit = 1; depth = 0 }
      hit { n = gsub(/\{/, "{"); m = gsub(/\}/, "}"); depth += n - m
            if (/"ref"/) { sub(/.*"ref"[^"]*"/, ""); sub(/".*/, ""); print; exit }
            if (depth <= 0) exit }' "$COPILOT_SETTINGS")
  fi
  copilot_channel=nightly; [ "$copilot_ref" = stable ] && copilot_channel=stable; [ -n "$copilot_version" ] || copilot_channel=stable

  installed=; present=
  for a in $AGENTS; do
    [ -z "$(get "$a" locked)" ] || continue
    if [ -n "$(get "$a" version)" ]; then installed="$installed $a"
    elif [ "$(get "$a" app)" = true ]; then present="$present $a"; fi
  done
}

status_table() {
  i=0
  for a in $AGENTS; do
    i=$((i + 1))
    v=$(get "$a" version); locked=$(get "$a" locked)
    if [ -n "$v" ]; then status="dkod $v ($(get "$a" channel))"
    elif [ -n "$locked" ]; then status=$locked
    elif [ "$(get "$a" app)" = true ]; then status="not installed"
    else status="$(label "$a") is not on this computer"; fi
    printf '  %s) %-20s %s\n' "$i" "$(label "$a")" "$status"
  done
}

# --- Install steps ------------------------------------------------------------------------------

stable_tag=
resolve_stable() {
  [ -z "$stable_tag" ] || return 0
  # The redirect of releases/latest names the tag, with no API call and no rate limit.
  url=$(curl -fsSLI --proto '=https' --tlsv1.2 --connect-timeout 15 -o /dev/null -w '%{url_effective}' "https://github.com/$REPO/releases/latest") \
    || fail "Could not reach github.com. Check your connection and try again."
  stable_tag=${url##*/tag/}
  case $stable_tag in v[0-9]*.[0-9]*.[0-9]*) ;; *) fail "No stable release of $REPO was found. Try again later, or choose nightly." ;; esac
}

restart=; signin=

# Says what changed. $1 agent, $2 version before, $3 version after, $4 channel.
report() {
  name=$(label "$1")
  if [ -z "$2" ]; then
    ok "$name: installed dkod ${3:-} ($4)."
    restart="$restart $1"; signin="$signin $1"
  elif [ "$2" != "$3" ]; then
    ok "$name: upgraded dkod $2 -> $3 ($4)."
    restart="$restart $1"
  elif [ "$(get "$1" channel)" != "$4" ]; then
    ok "$name: dkod $3 now follows $4."
    restart="$restart $1"
  else
    ok "$name: dkod $3 is the latest $4 version."
  fi
}

install_claude() {
  channel=$1; ref=$(ref_of "$channel"); before=$claude_version
  if [ -n "$claude_ref$before" ] || has_marketplace claude; then
    if [ "$claude_ref" != "$ref" ]; then
      step "Claude Code: switching the $MARKET marketplace to $channel..."
      claude plugin marketplace remove "$MARKET" >/dev/null 2>&1 || :
      claude plugin marketplace add "$REPO@$ref" >/dev/null || fail "Could not add the marketplace $REPO@$ref."
    else
      step "Claude Code: refreshing the $MARKET marketplace..."
      claude plugin marketplace update "$MARKET" >/dev/null || fail "Could not refresh the marketplace $MARKET."
    fi
  else
    step "Claude Code: adding the $MARKET marketplace ($channel)..."
    claude plugin marketplace add "$REPO@$ref" >/dev/null || fail "Could not add the marketplace $REPO@$ref."
  fi
  if [ -n "$(claude_installed_version)" ]; then
    claude plugin update "$PLUGIN_ID" >/dev/null || fail "Could not update $PLUGIN_ID."
  else
    step "Claude Code: installing $PLUGIN_ID..."
    claude plugin install "$PLUGIN_ID" >/dev/null || fail "Could not install $PLUGIN_ID. If your organization blocks plugins, ask your admin."
  fi
  report claude "$before" "$(claude_installed_version)" "$channel"
}

install_cursor() {
  channel=$1
  if [ "$channel" = stable ]; then
    resolve_stable
    archive="https://github.com/$REPO/archive/refs/tags/$stable_tag.tar.gz"
  else
    archive="https://github.com/$REPO/archive/refs/heads/main.tar.gz"
  fi
  before=$cursor_version
  step "Cursor: downloading the $channel plugin..."
  parent=$(dirname "$CURSOR_DIR")
  mkdir -p "$parent" "$CONFIG_DIR"
  # The new copy is unpacked next to the old one, then the two are swapped, so Cursor never loads half a plugin.
  work=$(mktemp -d "$parent/.dkod-install.XXXXXX")
  trap 'rm -rf "$work"' 0
  fetch "$archive" | tar -xz --strip-components 1 -C "$work" 2>/dev/null || fail "Could not download $archive."
  [ -f "$work/.cursor-plugin/plugin.json" ] || fail "The download is not the DKOD plugin. Nothing was changed."
  after=$(json_version "$work/.cursor-plugin/plugin.json")
  if [ "$before" = "$after" ] && [ "$cursor_channel" = "$channel" ]; then
    rm -rf "$work"; trap - 0
    report cursor "$before" "$after" "$channel"
    return 0
  fi
  if [ -n "$before" ] && [ "$channel" = stable ] && older "$after" "$before"; then
    note "Cursor: your copy ($before) is newer than stable ($after). Going back to stable."
  fi
  if [ -e "$CURSOR_DIR" ]; then mv "$CURSOR_DIR" "$work.old"; fi
  mv "$work" "$CURSOR_DIR"
  rm -rf "$work.old"; trap - 0
  printf '%s\n' "$channel" >"$CURSOR_CHANNEL_FILE"
  report cursor "$before" "$after" "$channel"
}

# Codex reads the same marketplace as Claude Code (.claude-plugin/marketplace.json).
install_codex() {
  channel=$1; ref=$(ref_of "$channel"); before=$codex_version
  if has_marketplace codex; then
    if [ "$codex_ref" != "$ref" ]; then
      step "Codex: switching the $MARKET marketplace to $channel..."
      codex plugin marketplace remove "$MARKET" >/dev/null 2>&1 || :
      codex plugin marketplace add "$REPO" --ref "$ref" >/dev/null || fail "Could not add the marketplace $REPO ($ref) to Codex."
    else
      step "Codex: refreshing the $MARKET marketplace..."
      codex plugin marketplace upgrade "$MARKET" >/dev/null || fail "Could not refresh the marketplace $MARKET in Codex."
    fi
  else
    step "Codex: adding the $MARKET marketplace ($channel)..."
    codex plugin marketplace add "$REPO" --ref "$ref" >/dev/null || fail "Could not add the marketplace $REPO ($ref) to Codex."
  fi
  codex plugin add "$PLUGIN_ID" >/dev/null || fail "Could not install $PLUGIN_ID in Codex. If your organization blocks plugins, ask your admin."
  report codex "$before" "$(codex_installed_version)" "$channel"
}

# Copilot CLI reads the same marketplace too. It takes the ref after a #, and it removes a marketplace
# only together with its plugins, so a channel switch installs the plugin again.
install_copilot() {
  channel=$1; ref=$(ref_of "$channel"); before=$copilot_version
  source="https://github.com/$REPO.git#$ref"
  if has_marketplace copilot; then
    if [ "$copilot_ref" != "$ref" ]; then
      step "Copilot: switching the $MARKET marketplace to $channel..."
      copilot plugin marketplace remove "$MARKET" --force >/dev/null 2>&1 || :
      copilot plugin marketplace add "$source" >/dev/null || fail "Could not add the marketplace $source to Copilot."
    else
      step "Copilot: refreshing the $MARKET marketplace..."
      copilot plugin marketplace update "$MARKET" >/dev/null || fail "Could not refresh the marketplace $MARKET in Copilot."
    fi
  else
    step "Copilot: adding the $MARKET marketplace ($channel)..."
    copilot plugin marketplace add "$source" >/dev/null || fail "Could not add the marketplace $source to Copilot."
  fi
  if [ -n "$(copilot_installed_version)" ]; then
    copilot plugin update "$PLUGIN_ID" >/dev/null || fail "Could not update $PLUGIN_ID in Copilot."
  else
    copilot plugin install "$PLUGIN_ID" >/dev/null || fail "Could not install $PLUGIN_ID in Copilot. If your organization blocks plugins, ask your admin."
  fi
  report copilot "$before" "$(copilot_installed_version)" "$channel"
}

not_here() {
  case $1 in
    claude) note "Claude Code is not installed. Install it from https://claude.com/claude-code, then run this again." ;;
    cursor) note "Cursor is not installed. Install it from https://cursor.com, then run this again." ;;
    codex) note "The Codex CLI is not installed. Install it from https://developers.openai.com/codex/cli, then run this again." ;;
    copilot) note "GitHub Copilot CLI is not installed. Install it from https://github.com/features/copilot/cli, then run this again." ;;
  esac
}

# Installs in one agent, or says why it cannot.
install_in() {
  a=$1 channel=$2
  locked=$(get "$a" locked)
  if [ -n "$locked" ]; then ok "$(label "$a"): $locked. Nothing to do."; return 0; fi
  if [ "$(get "$a" app)" != true ]; then not_here "$a"; return 0; fi
  "install_$a" "$channel"
}

next_steps() {
  say ""
  if [ -z "$restart" ]; then
    ok "Nothing to change. You are up to date."
    return 0
  fi
  say "$(paint 36 'Next')"
  if has "$restart" claude; then
    say "  Claude Code: quit every open Claude Code session and start it again, so it loads the new plugin."
    if has "$signin" claude; then say "  Claude Code: type /mcp, pick dkod, then Authenticate. You sign in with your company's own sign-in."; fi
  fi
  if has "$restart" cursor; then
    say "  Cursor: quit Cursor fully (Cmd+Q on a Mac) and open it again, so it loads the new plugin."
    if has "$signin" cursor; then
      say "  Cursor: open Settings, MCP, find DKOD and choose Connect. You sign in with your company's own sign-in."
      if command -v cursor-agent >/dev/null 2>&1; then say "  Cursor CLI: see https://github.com/$REPO#cursor-cli to sign in from cursor-agent."; fi
    fi
  fi
  if has "$restart" codex; then
    say "  Codex: quit every open Codex session and start it again, so it loads the new plugin."
    say "  Codex: when Codex asks to trust the DKOD hook, trust it. The hook stops a git push to your company's repos and a secret written into a file."
    if has "$signin" codex; then say "  Codex: run codex mcp login dkod. You sign in with your company's own sign-in."; fi
  fi
  if has "$restart" copilot; then
    say "  Copilot: quit every open Copilot CLI session and start it again, so it loads the new plugin."
    if has "$signin" copilot; then
      say "  Copilot: type /mcp and check dkod. When it asks you to sign in, use your company's own sign-in."
      say "  Copilot: if your organization's Copilot policy blocks third-party MCP servers, ask your GitHub admin to allow DKOD."
    fi
  fi
}

# --- graphify -----------------------------------------------------------------------------------
# graphify (https://github.com/Graphify-Labs/graphify) maps a project's code into a graph on this computer.
# The dkod skill makes the graph in the builder's project and asks it instead of reading file after file.

graphify_version() {
  PATH="$PATH:$HOME/.local/bin" graphify --version 2>/dev/null | sed -nE 's/.*([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' | head -n 1
}

# Recommends graphify and, with a yes, installs it with uv (else pipx). Never fails the install.
offer_graphify() {
  v=$(graphify_version)
  if [ -n "$v" ]; then ok "graphify $v is installed. The DKOD skill uses it to map your projects with fewer tokens."; return 0; fi
  say "$(paint 36 'Recommended first: graphify')"
  say "  graphify maps your project's code into a graph, on this computer. The DKOD skill asks the graph"
  say "  instead of reading file after file, so your agent spends far fewer tokens and works faster,"
  say "  above all when it migrates an app to DKOD. https://github.com/Graphify-Labs/graphify"
  say "  It works only on this computer: no telemetry, and the DKOD skill runs it with no AI service,"
  say "  so nothing about your code is sent anywhere."
  installer=
  if command -v uv >/dev/null 2>&1; then installer="uv tool install graphifyy"
  elif command -v pipx >/dev/null 2>&1; then installer="pipx install graphifyy"; fi
  if [ -z "$installer" ]; then
    note "To install it: install uv (https://docs.astral.sh/uv/getting-started/installation/), then run: uv tool install graphifyy"
    say ""
    return 0
  fi
  case ${DKOD_GRAPHIFY:-} in
    1) want=true ;;
    0) want=false ;;
    *) want=false; if [ -n "$TTY" ] && yes_no "Install graphify now, with $installer?" y; then want=true; fi ;;
  esac
  if [ "$want" = false ]; then
    say "  To install it later: $installer"
    say ""
    return 0
  fi
  step "graphify: $installer..."
  # shellcheck disable=SC2086
  if $installer >/dev/null 2>&1 && [ -n "$(graphify_version)" ]; then ok "graphify $(graphify_version) is installed."
  else note "Could not install graphify. Run it yourself: $installer"; fi
  say ""
}

# --- dk itself ----------------------------------------------------------------------------------

dk_version_of() { sed -nE 's/^DK_VERSION=([0-9.]+).*/\1/p' "$1" | head -n 1; }

# Downloads dk for a channel into $DK_BIN. Before the first release with dk in it, stable has no dk:
# then it takes main's. Prints nothing; returns 1 when dk could not be downloaded.
download_dk() {
  mkdir -p "$BIN_DIR"
  tmp=$(mktemp "$BIN_DIR/.dk.XXXXXX")
  if ! fetch "https://raw.githubusercontent.com/$REPO/$(ref_of "$1")/dk" >"$tmp" 2>/dev/null; then
    fetch "https://raw.githubusercontent.com/$REPO/main/dk" >"$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  fi
  if [ "$(head -n 1 "$tmp")" != "#!/bin/sh" ] || [ -z "$(dk_version_of "$tmp")" ]; then rm -f "$tmp"; return 1; fi
  chmod 755 "$tmp"
  if [ -f "$DK_BIN" ] && cmp -s "$tmp" "$DK_BIN"; then rm -f "$tmp"; return 0; fi
  mv "$tmp" "$DK_BIN"
}

on_path() { case ":$PATH:" in *":$BIN_DIR:"*) return 0 ;; esac; return 1; }

# Offers to put ~/.local/bin on the PATH in the shell's startup file.
ensure_path() {
  on_path && return 0
  case ${SHELL:-} in
    */zsh) rc="$HOME/.zshrc" ;;
    */bash) if [ "$(uname)" = Darwin ]; then rc="$HOME/.bash_profile"; else rc="$HOME/.bashrc"; fi ;;
    */fish) rc= ;;
    *) rc="$HOME/.profile" ;;
  esac
  line="export PATH=\"$BIN_DIR:\$PATH\""
  if [ -n "$rc" ] && [ -f "$rc" ] && grep -qF "$line" "$rc"; then
    note "$BIN_DIR is in $rc. Open a new terminal to use dk."
    return 0
  fi
  if [ -n "$rc" ] && [ -n "$TTY" ] && yes_no "dk is in $BIN_DIR, which is not on your PATH. Add it in $rc?" y; then
    printf '\n# dk, the DKOD plugin manager\n%s\n' "$line" >>"$rc"
    ok "Added $BIN_DIR to your PATH in $rc. Open a new terminal to use dk."
  else
    note "dk is in $BIN_DIR, which is not on your PATH. Add this line to your shell's startup file: $line"
  fi
}

# --- Commands -----------------------------------------------------------------------------------

cmd_help() {
  cat <<EOF
dk $DK_VERSION: the DKOD plugin in Claude Code, Cursor, Codex and GitHub Copilot CLI.

  dk install          Asks which agents should get the plugin, and which channel, then installs it.
  dk upgrade          Upgrades dk, then the plugin in every agent that has it.
  dk channel          Shows the channel. dk channel stable or dk channel nightly switches dk and
                      every installed plugin to it.
  dk doctor           Checks dk, each agent, the plugin versions and the DKOD server, and names any issue.
  dk uninstall        Asks what to remove: the plugin, its MCP server and skills in each agent, and dk.
  dk version          Prints the version of dk.

Channels: stable is the latest release (the default). nightly is the newest build, published every night.
EOF
}

cmd_install() {
  open_tty
  show_wordmark
  say ""
  offer_graphify
  detect
  status_table
  say ""

  agent=$(printf '%s' "${DKOD_AGENT:-}" | tr ',' ' ')
  channel=${DKOD_CHANNEL:-}
  case $channel in ''|stable|nightly) ;; *) fail "DKOD_CHANNEL must be stable or nightly." ;; esac
  chosen=
  for a in $agent; do
    case $a in
      claude|cursor|codex|copilot) chosen="$chosen $a" ;;
      both) chosen="$chosen claude cursor" ;;
      all) chosen=" $AGENTS" ;;
      *) fail "DKOD_AGENT takes claude, cursor, codex, copilot or all, separated by commas." ;;
    esac
  done

  own_channel=false
  if [ -z "$chosen" ] && [ -z "$TTY" ]; then
    # No one to ask: upgrade what is installed, each on the channel it follows.
    [ -n "$installed" ] || fail "No terminal to ask in. Run it again with DKOD_AGENT=claude, cursor, codex, copilot or all."
    chosen=$installed
    own_channel=true
  elif [ -z "$chosen" ]; then
    default=${installed:-$present}
    numbers=
    for d in $default; do
      i=0; for a in $AGENTS; do i=$((i + 1)); [ "$a" = "$d" ] && numbers="$numbers $i"; done
    done
    numbers=${numbers# }
    say "Which agents should get the DKOD plugin? It installs it, or upgrades the copy you have."
    say "Type the numbers with spaces between them, like 1 3, or all."
    if [ -n "$numbers" ]; then printf 'Agents [%s]: ' "$numbers"; else printf 'Agents: '; fi
    reply=$(ask "$numbers")
    say ""
    for n in $(printf '%s' "$reply" | tr ',' ' '); do
      case $n in
        1) chosen="$chosen claude" ;; 2) chosen="$chosen cursor" ;; 3) chosen="$chosen codex" ;; 4) chosen="$chosen copilot" ;;
        all) chosen=" $AGENTS" ;;
        *) fail "Type the numbers 1 to 4, or all." ;;
      esac
    done
    [ -n "$chosen" ] || { ok "Nothing chosen. Nothing was changed."; return 0; }
  fi

  if [ -z "$channel" ] && [ "$own_channel" = false ]; then
    # dk's own channel once one was chosen; else nightly when every chosen copy already follows it.
    default=1
    if [ -f "$DK_CHANNEL_FILE" ]; then
      [ "$(dk_channel)" = nightly ] && default=2
    else
      any=false all_nightly=true
      for a in $chosen; do
        [ -n "$(get "$a" version)" ] || continue
        any=true
        [ "$(get "$a" channel)" = nightly ] || all_nightly=false
      done
      [ "$any" = true ] && [ "$all_nightly" = true ] && default=2
    fi
    if [ -n "$TTY" ]; then
      say "Which channel?"
      say "  1) stable   the latest release $(paint 32 '(recommended)')"
      say "  2) nightly  the newest build, published every night"
      printf 'Channel [%s]: ' "$default"
      case $(ask "$default") in 1|stable) channel=stable ;; 2|nightly) channel=nightly ;; *) fail "Choose 1 or 2." ;; esac
      say ""
    else
      channel=stable; [ "$default" = 2 ] && channel=nightly
    fi
  fi
  [ -z "$channel" ] || save_dk_channel "$channel"

  done_list=
  for a in $chosen; do
    has "$done_list" "$a" && continue
    done_list="$done_list $a"
    if [ "$own_channel" = true ] && [ -z "$channel" ]; then install_in "$a" "$(get "$a" channel)"; else install_in "$a" "$channel"; fi
  done
  next_steps
  [ "$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")" != "$DK_BIN" ] || ensure_path
}

cmd_upgrade() {
  open_tty
  channel=$(dk_channel)
  before=$(dk_version_of "$DK_BIN" 2>/dev/null || :)
  step "dk: checking the $channel version..."
  download_dk "$channel" || fail "Could not download dk from github.com/$REPO. Check your connection and try again."
  after=$(dk_version_of "$DK_BIN")
  if [ -z "$before" ]; then ok "dk: installed $after in $DK_BIN."
  elif [ "$before" != "$after" ]; then ok "dk: upgraded $before -> $after."
  else ok "dk: $after is the latest $channel version."; fi
  # The new dk upgrades the plugin, so a fixed upgrade step takes effect at once.
  exec sh "$DK_BIN" __upgrade-plugins
}

upgrade_plugins() {
  detect
  if [ -z "$installed" ]; then
    say ""
    note "The plugin is in no agent yet. Run dk install."
    return 0
  fi
  for a in $installed; do install_in "$a" "$(get "$a" channel)"; done
  next_steps
}

cmd_channel() {
  open_tty
  current=$(dk_channel)
  case ${1:-} in
    '')
      say "Channel: $current"
      detect
      for a in $installed; do say "  $(label "$a"): dkod $(get "$a" version) ($(get "$a" channel))"; done
      say "Switch with: dk channel stable, or dk channel nightly."
      return 0 ;;
    stable|nightly) ;;
    *) fail "The channel is stable or nightly." ;;
  esac
  save_dk_channel "$1"
  ok "dk now follows $1."
  download_dk "$1" || note "Could not download dk for $1. dk stays as it is; run dk upgrade later."
  exec sh "$DK_BIN" __switch-plugins "$1"
}

switch_plugins() {
  detect
  for a in $installed; do install_in "$a" "$1"; done
  [ -n "$installed" ] || note "The plugin is in no agent yet. Run dk install."
  next_steps
}

# Prints the plugin version on a branch of the repository, or nothing.
remote_version() {
  fetch "https://raw.githubusercontent.com/$REPO/$1/.claude-plugin/plugin.json" 2>/dev/null \
    | sed -nE 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' | head -n 1
}

issues=0
issue() { issues=$((issues + 1)); note "$*"; }

agent_version() {
  case $1 in
    claude) claude --version 2>/dev/null | head -n 1 ;;
    cursor) if command -v cursor >/dev/null 2>&1; then cursor --version 2>/dev/null | head -n 1; else printf 'app'; fi ;;
    codex) codex --version 2>/dev/null | head -n 1 ;;
    copilot) copilot --version 2>/dev/null | head -n 1 ;;
  esac
}

cmd_doctor() {
  say "$(paint 36 'dk')"
  if [ -f "$DK_BIN" ]; then ok "dk $DK_VERSION in $DK_BIN, channel $(dk_channel)."
  else issue "dk is not installed in $DK_BIN. Run: curl -fsSL https://raw.githubusercontent.com/$REPO/main/install.sh | sh"; fi
  if on_path; then ok "$BIN_DIR is on your PATH."; else issue "$BIN_DIR is not on your PATH, so the dk command is not found. Add: export PATH=\"$BIN_DIR:\$PATH\""; fi
  for c in curl tar; do command -v "$c" >/dev/null 2>&1 || issue "$c is not installed. dk needs it."; done
  gv=$(graphify_version)
  if [ -n "$gv" ]; then ok "graphify $gv is installed: the DKOD skill maps your projects with it."
  else issue "graphify is not installed. The DKOD skill needs it to spend fewer tokens: run uv tool install graphifyy (https://github.com/Graphify-Labs/graphify)."; fi

  say ""
  say "$(paint 36 'Versions on GitHub')"
  stable_v=$(remote_version stable); nightly_v=$(remote_version main)
  if [ -n "$stable_v$nightly_v" ]; then
    ok "stable: dkod ${stable_v:-unknown}. nightly: dkod ${nightly_v:-unknown}."
  else
    issue "Could not read the plugin versions from github.com/$REPO. Check your connection."
  fi
  code=$(curl -s -o /dev/null -w '%{http_code}' --connect-timeout 10 --max-time 20 "$MCP_URL" 2>/dev/null || :)
  case $code in
    2*|3*|401|403|405|406) ok "The DKOD server answers ($MCP_URL)." ;;
    *) issue "The DKOD server did not answer ($MCP_URL, HTTP ${code:-none}). Check your connection or proxy." ;;
  esac

  detect
  for a in $AGENTS; do
    say ""
    name=$(label "$a")
    if [ "$(get "$a" app)" != true ] && [ -z "$(get "$a" version)" ]; then
      say "$(paint 36 "$name")  not on this computer"
      continue
    fi
    say "$(paint 36 "$name")  $(agent_version "$a")"
    locked=$(get "$a" locked)
    if [ -n "$locked" ]; then ok "dkod: $locked."; continue; fi
    v=$(get "$a" version); ch=$(get "$a" channel)
    if [ -z "$v" ]; then say "  dkod is not installed. Run dk install to add it."; continue; fi
    if [ "$ch" = nightly ]; then want=$nightly_v; else want=$stable_v; fi
    if [ -n "$want" ] && older "$v" "$want"; then issue "dkod $v ($ch). $want is out: run dk upgrade."
    else ok "dkod $v ($ch), the latest."; fi
    [ "$ch" = "$(dk_channel)" ] || [ ! -f "$DK_CHANNEL_FILE" ] || issue "The plugin follows $ch, dk follows $(dk_channel). Run dk channel $(dk_channel) to align them."
    case $a in
      cursor)
        command -v node >/dev/null 2>&1 || issue "node is not installed. The DKOD hook in Cursor runs with node." ;;
      codex)
        auth=$(codex mcp list 2>/dev/null | awk '$1 == "dkod" { print }')
        if [ -z "$auth" ]; then issue "Codex does not list the dkod MCP server. Run dk install to install the plugin again."
        else case $auth in *"Not logged in"*) issue "Codex is not signed in to DKOD. Run: codex mcp login dkod" ;; *) ok "The dkod MCP server is set up in Codex." ;; esac; fi ;;
      copilot)
        if copilot mcp list 2>/dev/null | grep -q dkod; then ok "Copilot lists the dkod MCP server."
        else issue "Copilot does not list the dkod MCP server. Your organization's Copilot policy may block it."; fi ;;
    esac
  done
  say ""
  if [ "$issues" -eq 0 ]; then ok "No issues found."; else note "$issues issue(s) found."; return 1; fi
}

# Everything dk can remove, one per line: id|what it is. Company and team copies are never offered.
removable() {
  detect
  [ -n "$claude_version" ] && echo "claude-plugin|Claude Code: the dkod plugin $claude_version, with its MCP server and skills"
  [ "$claude_app" = true ] && [ -z "$claude_locked" ] && has_marketplace claude && echo "claude-market|Claude Code: the $MARKET marketplace"
  [ "$claude_app" = true ] && claude mcp get dkod >/dev/null 2>&1 && echo "claude-mcp|Claude Code: a dkod MCP server you added by hand"
  for d in "$HOME/.claude/skills/dkod" "$HOME/.claude/skills/dkod-migrate"; do [ -d "$d" ] && echo "skill:$d|Claude Code: the skill in $d"; done
  [ -n "$cursor_version" ] && [ -d "$CURSOR_DIR" ] && echo "cursor-plugin|Cursor: the dkod plugin $cursor_version, with its MCP server, skills and rule"
  [ -f "$HOME/.cursor/mcp.json" ] && grep -q '"dkod"' "$HOME/.cursor/mcp.json" && echo "cursor-mcp|Cursor: the dkod MCP server in ~/.cursor/mcp.json"
  [ -n "$codex_version" ] && echo "codex-plugin|Codex: the dkod plugin $codex_version, with its MCP server, skills and hook"
  [ "$codex_app" = true ] && has_marketplace codex && echo "codex-market|Codex: the $MARKET marketplace"
  for d in "${CODEX_HOME:-$HOME/.codex}/skills/dkod" "${CODEX_HOME:-$HOME/.codex}/skills/dkod-migrate"; do [ -d "$d" ] && echo "skill:$d|Codex: the skill in $d"; done
  [ -n "$copilot_version" ] && echo "copilot-plugin|GitHub Copilot CLI: the dkod plugin $copilot_version, with its MCP server, skills and hook"
  [ "$copilot_app" = true ] && has_marketplace copilot && echo "copilot-market|GitHub Copilot CLI: the $MARKET marketplace"
  [ -f "$DK_BIN" ] && echo "dk|dk itself ($DK_BIN) and its settings ($CONFIG_DIR)"
  return 0
}

# Removes the dkod entry from a JSON file of MCP servers, with node or python3. 1 when neither is here.
drop_json_key() {
  if command -v node >/dev/null 2>&1; then
    node -e 'const f=process.argv[1],fs=require("fs"),j=JSON.parse(fs.readFileSync(f,"utf8"));if(j.mcpServers)delete j.mcpServers.dkod;fs.writeFileSync(f,JSON.stringify(j,null,2)+"\n")' "$1"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -I -c 'import json,sys;f=sys.argv[1];j=json.load(open(f));j.get("mcpServers",{}).pop("dkod",None);open(f,"w").write(json.dumps(j,indent=2)+"\n")' "$1"
  else
    return 1
  fi
}

remove_item() {
  case $1 in
    claude-plugin) claude plugin uninstall "$PLUGIN_ID" >/dev/null 2>&1 || claude plugin uninstall "$PLUGIN_ID" --scope user >/dev/null || return 1 ;;
    claude-market) claude plugin marketplace remove "$MARKET" >/dev/null ;;
    claude-mcp) claude mcp remove dkod --scope user >/dev/null 2>&1 || claude mcp remove dkod >/dev/null ;;
    cursor-plugin) rm -rf "$CURSOR_DIR" "$CURSOR_CHANNEL_FILE" ;;
    cursor-mcp) drop_json_key "$HOME/.cursor/mcp.json" || { note "Remove the \"dkod\" entry from ~/.cursor/mcp.json by hand: dk needs node or python3 to edit it."; return 0; } ;;
    codex-plugin) codex plugin remove "$PLUGIN_ID" >/dev/null ;;
    codex-market) codex plugin marketplace remove "$MARKET" >/dev/null ;;
    copilot-plugin) copilot plugin uninstall "$PLUGIN_ID" >/dev/null ;;
    copilot-market) copilot plugin marketplace remove "$MARKET" --force >/dev/null ;;
    skill:*) rm -rf "${1#skill:}" ;;
    dk) rm -f "$DK_BIN"; rm -rf "$CONFIG_DIR" ;;
  esac
}

cmd_uninstall() {
  open_tty
  list=$(removable)
  if [ -z "$list" ]; then ok "Nothing of DKOD is installed here."; return 0; fi
  all=false
  case ${1:-} in --all|all) all=true ;; '') ;; *) fail "dk uninstall takes no argument, or --all." ;; esac
  if [ "$all" = false ] && [ -z "$TTY" ]; then fail "No terminal to ask in. Run dk uninstall --all to remove everything."; fi
  say "What should dk remove?"
  printf '%s\n' "$list" | awk -F'|' '{ printf "  %d) %s\n", NR, $2 }'
  count=$(printf '%s\n' "$list" | wc -l | tr -d ' ')
  if [ "$all" = true ]; then
    picks=$(seq 1 "$count" | tr '\n' ' ')
  else
    say "Type the numbers with spaces between them, or all. Enter removes nothing."
    printf 'Remove: '
    picks=$(ask "")
    say ""
    [ "$picks" = all ] && picks=$(seq 1 "$count" | tr '\n' ' ')
    [ -n "$picks" ] || { ok "Nothing removed."; return 0; }
    for n in $picks; do
      case $n in *[!0-9]*|'') fail "Type numbers from 1 to $count, or all." ;; esac
      [ "$n" -ge 1 ] && [ "$n" -le "$count" ] || fail "Type numbers from 1 to $count, or all."
    done
    yes_no "Remove $(printf '%s\n' $picks | sort -un | wc -l | tr -d ' ') item(s)?" n || { ok "Nothing removed."; return 0; }
  fi
  # The plugins first, so a marketplace is never removed under its own plugin; dk last.
  for kind in plugin mcp skill market dk; do
    for n in $(printf '%s\n' $picks | sort -un); do
      line=$(printf '%s\n' "$list" | sed -n "${n}p")
      id=${line%%|*}; what=${line#*|}
      case $id in *-$kind|$kind|$kind:*) ;; *) continue ;; esac
      if remove_item "$id"; then ok "Removed $what."; else note "Could not remove $what."; fi
    done
  done
  say ""
  say "Restart your agents, so they drop what was removed."
}

case ${1:-help} in
  install) cmd_install ;;
  upgrade|update) cmd_upgrade ;;
  uninstall|remove) shift; cmd_uninstall "${1:-}" ;;
  doctor) cmd_doctor ;;
  channel) shift; cmd_channel "${1:-}" ;;
  version|--version|-v) say "dk $DK_VERSION" ;;
  help|--help|-h) cmd_help ;;
  __upgrade-plugins) upgrade_plugins ;;
  __switch-plugins) open_tty; switch_plugins "$2" ;;
  *) cmd_help >&2; exit 1 ;;
esac
