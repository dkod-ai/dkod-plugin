#!/bin/sh
# Copy dest is local .git/hooks/pre-push.
# Refuses a push to the classified app remote unless a matching Deliver stamp exists.
set -eu

REFUSE_MSG="Push refused: call Deliver (dkoder.deliver) before pushing to the app remote."

git_dir="${GIT_DIR:-.git}"
dkoder_dir="${git_dir}/dkoder"

remote_url="${2:-}"
[ -z "$remote_url" ] && exit 0

normalize_remote() {
  r="$1"
  r=$(printf '%s' "$r" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  [ -z "$r" ] && {
    printf ''
    return 0
  }

  case "$r" in
    *@*:*)
      r="${r#*@}"
      host="${r%%:*}"
      path="${r#*:}"
      r="${host}/${path}"
      ;;
  esac

  r="${r#https://}"
  r="${r#http://}"
  r="${r#ssh://}"
  r="${r#git://}"

  case "$r" in
    *@*) r="${r#*@}" ;;
  esac

  r="${r%/}"
  r="${r%.git}"
  printf '%s' "$r" | tr '[:upper:]' '[:lower:]'
}

# Malformed session → treat as missing (fail open). Returns 0 when valid.
load_session() {
  file="$1"
  sessionId=""
  appKey=""
  appRemote=""
  governanceRemote=""
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '' | '#'*) continue ;;
      *=*)
        key="${line%%=*}"
        val="${line#*=}"
        case "$key" in
          sessionId) sessionId="$val" ;;
          appKey) appKey="$val" ;;
          appRemote) appRemote="$val" ;;
          governanceRemote) governanceRemote="$val" ;;
          *) : ;;
        esac
        ;;
      *) return 1 ;;
    esac
  done <"$file"
  [ -n "$sessionId" ] && [ -n "$appKey" ] && [ -n "$appRemote" ] && [ -n "$governanceRemote" ]
}

# Malformed stamp → fail closed on a classified app dest. Returns 0 when valid.
load_deliver() {
  file="$1"
  sessionId=""
  appKey=""
  remote=""
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '' | '#'*) continue ;;
      *=*)
        key="${line%%=*}"
        val="${line#*=}"
        case "$key" in
          sessionId) sessionId="$val" ;;
          appKey) appKey="$val" ;;
          remote) remote="$val" ;;
          *) : ;;
        esac
        ;;
      *) return 1 ;;
    esac
  done <"$file"
  [ -n "$sessionId" ] && [ -n "$appKey" ] && [ -n "$remote" ]
}

norm_push=$(normalize_remote "$remote_url")

session_file="${dkoder_dir}/session"
deliver_file="${dkoder_dir}/deliver"

sess_id=""
sess_key=""
sess_app=""
sess_gov=""
session_ok=0
if [ -f "$session_file" ] && load_session "$session_file"; then
  session_ok=1
  sess_id="$sessionId"
  sess_key="$appKey"
  sess_app="$appRemote"
  sess_gov="$governanceRemote"
fi

gov_norm=$(normalize_remote "$sess_gov")
app_norm=$(normalize_remote "$sess_app")

if [ -n "$gov_norm" ] && [ "$norm_push" = "$gov_norm" ]; then
  exit 0
fi

if [ -z "$app_norm" ] || [ "$norm_push" != "$app_norm" ]; then
  exit 0
fi

if [ "$session_ok" != 1 ]; then
  exit 0
fi

if [ ! -f "$deliver_file" ]; then
  echo "$REFUSE_MSG" >&2
  exit 1
fi

if ! load_deliver "$deliver_file"; then
  echo "$REFUSE_MSG" >&2
  exit 1
fi

stamp_remote=$(normalize_remote "$remote")
if [ "$sessionId" != "$sess_id" ] || [ "$appKey" != "$sess_key" ] || [ "$stamp_remote" != "$norm_push" ]; then
  echo "$REFUSE_MSG" >&2
  exit 1
fi

exit 0
